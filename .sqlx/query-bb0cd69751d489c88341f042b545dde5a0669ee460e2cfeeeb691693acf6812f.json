{
  "db_name": "PostgreSQL",
  "query": "SELECT id, at, actor_kind, actor_id, actor_label, client_ip, user_agent, action, target_type, target_id, outcome, details\n               FROM audit_events\n               WHERE ($1::bigint IS NULL OR actor_id = $1)\n                 AND ($2::text IS NULL OR action = $2)\n                 AND ($3::inet IS NULL OR client_ip = $3)\n                 AND ($4::timestamptz IS NULL OR at >= $4)\n                 AND ($5::bigint IS NULL OR id < $5)\n               ORDER BY id DESC\n               LIMIT $6",
